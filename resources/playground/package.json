{
  "name": "playground",
  "version": "0.1.0",
  "author": "filip",
  "description": "Pískoviště pro M2O Scripting API",
  "private": true,
  "scripts": {
    "check": "tsc -p server/tsconfig.json && tsc -p client/tsconfig.json && node --check server/main.js && node --check client/main.js"
  },
  "devDependencies": {
    "@mafia2online/types": "^1.7.0",
    "typescript": "^5.9.0"
  },
  "mafiahub": {
    "serverScripts": ["server/main.js"],
    "clientScripts": ["client/main.js"],
    "files": ["client/**/*.js"],
    "priority": 10
  }
}
